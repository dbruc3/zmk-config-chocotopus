#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

&mt {
    tapping-term-ms = <400>;
};

/ {
  keymap {
    compatible = "zmk,keymap";


    default_layer {
      bindings = <
        &kp TAB   &kp Q &kp W &kp E &kp R &kp T           &kp Y &kp U &kp I &kp O &kp P &kp BSPC
        &kp ESC   &kp A &kp S &kp D &kp F &kp G           &kp H &kp J &kp K &kp L &kp SEMI &kp SQT
        &kp LSHFT &kp Z &kp X &kp C &kp V &kp B  &kp RET  &kp N &kp M &kp COMMA &kp DOT &kp FSLH &mt RSHFT RET
              &kp LGUI &kp LALT &kp LCTRL &lt 1 SPACE           &kp SPACE &mt RCTRL RC(B) &kp LEFT &kp RIGHT
      >;
      sensor-bindings = <&inc_dec_kp UP DOWN>;
    };

    lower_layer {
      bindings = <
        &kp TILDE &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT      &kp CARET &kp AMPS &kp STAR &kp MINUS &kp EQUAL &kp DEL
        &kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5               &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp PIPE
        &kp LPAR &none &none &none &kp LBRC &kp LBKT        &kp RET      &kp RBKT &kp RBRC &kp BSLH &kp UNDER &kp PLUS &kp RPAR
                         &trans &trans &trans &trans               &kp SPACE &mo 2 &trans &trans
      >;
      sensor-bindings = <&inc_dec_kp LEFT RIGHT>;
    };

    adjust_layer {
      bindings = <
        &kp K_POWER &none &none &none &none &bt BT_CLR             &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &kp K_MUTE
        &kp K_BACK &kp F1 &kp F2 &kp F3 &kp F4 &kp F5              &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp K_VOL_UP
        &kp K_LOCK &kp F11 &kp F12 &none &none &none        &kp RET      &sys_reset &bootloader &none &none &none &kp K_VOL_DN
                          &trans &trans &trans &trans              &trans &trans &trans &trans
      >;
      sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
    };

  };
};
